{
	"name": "obsidian-publish",
	"version": "26.9.3",
	"description": "MDFriday Publish — turn notes and folders into shareable websites via Cloudflare. Desktop.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"svelte-check": "svelte-check --tsconfig ./tsconfig.json",
		"tsc-check": "tsc --noEmit -skipLibCheck",
		"check": "npm run tsc-check && npm run svelte-check",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"lint:ci": "eslint src/ --max-warnings=0",
		"verify:theme-config": "node scripts/verify-theme-config.mjs"
	},
	"keywords": [
		"mdfriday",
		"publish",
		"obsidian",
		"markdown",
		"website",
		"cloudflare"
	],
	"author": "sunwei",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/svelte": "^5.0.5",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.13.8",
		"esbuild": "0.25.0",
		"esbuild-svelte": "^0.9.3",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"events": "^3.3.0",
		"globals": "^17.7.0",
		"obsidian": "^1.8.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.3.3",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.63.0"
	},
	"dependencies": {
		"@mdfriday/foundry": "^26.9.2"
	}
}
